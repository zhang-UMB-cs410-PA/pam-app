OPENAI_API_KEY=
# Supabase project settings -> API. The service-role key bypasses row-level security: server only, never in the app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Test user until Supabase Auth is added (same value as backend/.env)
PAM_TEST_USER_ID=
# Optional overrides: PORT=8787, PAM_APP_ORIGIN=http://localhost:8081, PAM_MODEL, PAM_TRANSCRIBE_MODEL, PAM_VOICE_MODEL, PAM_VOICE
